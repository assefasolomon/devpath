    <!-- SUMMARY -->
    <div class="section-block" id="summary">
      <div class="section-header">
        <div class="section-icon">📝</div>
        <div>
          <div class="section-title-text">Lesson Summary</div>
          <div class="section-subtitle">Everything you learned in Lesson 1</div>
        </div>
      </div>
      <div class="summary-card">
        <div class="summary-title">✅ Key Points — Logic and Propositions</div>
        <ul class="summary-list">
          <li>A <strong>proposition</strong> is a declarative sentence that is either True or False — questions, commands and open sentences are not propositions.</li>
          <li><strong>Negation</strong> (¬p) flips the truth value. <strong>Conjunction</strong> (p∧q) is true only when both are true. <strong>Disjunction</strong> (p∨q) is false only when both are false.</li>
          <li><strong>Implication</strong> (p→q) is false ONLY when p is True and q is False. All other cases are True, including when p is False (vacuously true).</li>
          <li><strong>Biconditional</strong> (p↔q) is true when p and q have the same truth value; false when they differ.</li>
          <li>A <strong>tautology</strong> is always True; a <strong>contradiction</strong> is always False. Verify using a truth table.</li>
          <li>The <strong>contrapositive</strong> (¬q→¬p) is logically equivalent to the original conditional (p→q). The converse (q→p) and inverse (¬p→¬q) are equivalent to each other but not to the original.</li>
          <li><strong>De Morgan's Laws</strong>: ¬(p∧q) ≡ ¬p∨¬q &nbsp; and &nbsp; ¬(p∨q) ≡ ¬p∧¬q. When negating a bracket, flip the connective and negate each part.</li>
        </ul>
      </div>
    </div>

    <div class="lesson-nav">
      <a href="../index.html" class="btn btn-ghost">← Course Index</a>
      <div style="text-align:center;font-size:.82rem;color:var(--text-muted)">Unit 7 · Lesson 1 of 2</div>
      <a href="unit7-lesson2.html" class="btn btn-primary">Next: Methods of Proof →</a>
    </div>

  </main>
</div>

<script>
  fetch('/api/auth/me',{credentials:'include'})
    .then(r=>r.json())
    .then(d=>{if(!d.user)location.href='/login.html?reason=login_required';})
    .catch(()=>{});

  const answers={};
  const correct={1:'D',2:'B',3:'C',4:'B',5:'C'};
  const feedbacks={
    1:{D:'✓ Correct! "The square root of 9 is 3" is a declarative sentence with a clear truth value (True).',wrong:'✗ Only a declarative sentence with a definite True or False truth value is a proposition. "√9 = 3" is True — it is a proposition.'},
    2:{B:'✓ Correct! p→q is False ONLY when p is True and q is False. Here p=T and q=F, so p→q = False.',wrong:'✗ The implication p→q is False only when the hypothesis (p) is True and the conclusion (q) is False. Since p=T and q=F, the result is False.'},
    3:{C:'✓ Correct! Contrapositive of p→q is ¬q→¬p: "If I do NOT go outside, then it is NOT sunny."',wrong:'✗ The contrapositive of "If p then q" is "If not q then not p". So: "If I do not go outside, then it is not sunny."'},
    4:{B:'✓ Correct! De Morgan\'s second law: ¬(p∨q) ≡ ¬p ∧ ¬q.',wrong:'✗ De Morgan\'s Law: ¬(p∨q) ≡ ¬p ∧ ¬q. When negating a disjunction, the connective flips to conjunction.'},
    5:{C:'✓ Correct! A tautology is a compound proposition that is True for all possible truth value combinations.',wrong:'✗ A proposition that is always True regardless of component truth values is called a tautology. A contradiction is always False.'},
  };
  let answered=0;

  function answer(qNum,chosen,correctAns){
    if(answers[qNum])return;
    answers[qNum]=chosen;answered++;
    const card=document.getElementById('q'+qNum);
    const opts=card.querySelectorAll('.quiz-option');
    const fb=document.getElementById('q'+qNum+'-feedback');
    const letters=['A','B','C','D'];
    opts.forEach((o,i)=>{
      o.classList.add('disabled');
      if(letters[i]===correctAns)o.classList.add('correct');
      else if(letters[i]===chosen&&chosen!==correctAns)o.classList.add('wrong');
    });
    const ok=chosen===correctAns;
    fb.textContent=ok?feedbacks[qNum][correctAns]:feedbacks[qNum].wrong;
    fb.className='quiz-feedback show '+(ok?'correct':'wrong');
    updateProgress();
    if(answered===5)showScore();
  }

  function showScore(){
    const score=Object.keys(answers).filter(q=>answers[q]===correct[q]).length;
    document.getElementById('score-bar').classList.add('show');
    document.getElementById('score-num').textContent=score+'/5';
    const labels=['📖 Review and try again.','📖 Review and try again.','📖 Review and try again.','👍 Good! Check your mistakes.','👍 Almost perfect!','🎉 Perfect score!'];
    document.getElementById('score-label').textContent=labels[score];
  }

  function retakeQuiz(){
    Object.keys(answers).forEach(k=>delete answers[k]);
    answered=0;
    for(let i=1;i<=5;i++){
      document.getElementById('q'+i).querySelectorAll('.quiz-option').forEach(o=>{o.className='quiz-option';});
      document.getElementById('q'+i+'-feedback').className='quiz-feedback';
    }
    document.getElementById('score-bar').classList.remove('show');
    updateProgress();
    document.getElementById('quiz').scrollIntoView({behavior:'smooth'});
  }

  function updateProgress(){
    document.getElementById('progress-fill').style.width=(answered/5*100)+'%';
  }

  function scrollTo(id){
    document.getElementById(id).scrollIntoView({behavior:'smooth',block:'start'});
    event.currentTarget.classList.add('active');
  }

  const sections=['intro','explanation','formula','examples','quiz','resources','summary'];
  window.addEventListener('scroll',()=>{
    let current='intro';
    sections.forEach(id=>{
      const el=document.getElementById(id);
      if(el&&window.scrollY>=el.offsetTop-120)current=id;
    });
    document.querySelectorAll('.sidebar-link[onclick]').forEach(l=>{
      const t=l.getAttribute('onclick').match(/'([^']+)'/)?.[1];
      l.classList.toggle('active',t===current);
    });
  });
</script>
</body>
</html>

    .formula-math{font-size:1rem;font-weight:700;color:#22C55E;font-family:'Georgia',serif;line-height:1.4}
    .formula-note{font-size:.72rem;color:rgba(255,255,255,.5);margin-top:.4rem;line-height:1.5}
    .example-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden;margin-bottom:1.25rem}
    .example-header{background:var(--brand-primary);padding:.875rem 1.5rem;display:flex;align-items:center;gap:10px}
    .example-num{background:rgba(255,255,255,.2);color:#fff;font-size:.75rem;font-weight:800;padding:3px 10px;border-radius:999px}
    .example-title{font-size:.875rem;font-weight:700;color:#fff}
    .example-body{padding:1.5rem}
    .example-problem{background:var(--surface-2);border-radius:var(--radius);padding:.875rem 1rem;font-size:.9rem;color:var(--heading);margin-bottom:1rem;border-left:3px solid var(--brand-accent)}
    .example-step{display:flex;gap:.875rem;margin-bottom:.75rem;align-items:flex-start}
    .step-badge{background:var(--brand-light);color:var(--brand-primary);font-size:.72rem;font-weight:700;padding:2px 8px;border-radius:999px;white-space:nowrap;flex-shrink:0;margin-top:2px}
    .step-text{font-size:.875rem;color:var(--text);line-height:1.7}
    .step-text .math{color:var(--brand-primary);font-weight:700;font-family:'Georgia',serif}
    .example-answer{background:#F0FDF4;border:1.5px solid #86EFAC;border-radius:var(--radius);padding:.875rem 1rem;font-size:.9rem;color:#166534;font-weight:700;margin-top:1rem}
    /* truth table */
    .truth-table{width:100%;border-collapse:collapse;font-size:.875rem;margin:.875rem 0;font-family:'Georgia',serif}
    .truth-table th{background:var(--brand-primary);color:#fff;padding:.5rem .875rem;text-align:center;font-weight:700;font-family:var(--font-sans)}
    .truth-table td{padding:.5rem .875rem;border-bottom:1px solid var(--border);text-align:center}
    .truth-table tr:nth-child(even) td{background:var(--surface-2)}
    .truth-table .T{color:#16A34A;font-weight:700}
    .truth-table .F{color:#DC2626;font-weight:700}
    .truth-table .highlight td{background:#DCFCE7;font-weight:700}
    .quiz-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius-xl);padding:1.75rem;margin-bottom:1rem}
    .quiz-num{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--brand-primary);margin-bottom:.5rem}
    .quiz-question{font-size:.95rem;font-weight:700;color:var(--heading);margin-bottom:1.25rem;line-height:1.6}
    .quiz-options{display:flex;flex-direction:column;gap:.5rem}
    .quiz-option{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;border:1.5px solid var(--border);border-radius:var(--radius);cursor:pointer;transition:all var(--transition);font-size:.875rem;color:var(--text)}
    .quiz-option:hover{border-color:var(--brand-accent);background:#F0FDF4}
    .quiz-option.correct{border-color:#16A34A;background:#F0FDF4;color:#166534}
    .quiz-option.wrong{border-color:#DC2626;background:#FEF2F2;color:#991B1B}
    .quiz-option.disabled{cursor:not-allowed;pointer-events:none}
    .option-letter{width:28px;height:28px;border-radius:50%;background:var(--surface-2);color:var(--text-muted);display:flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:700;flex-shrink:0}
    .quiz-option.correct .option-letter{background:#16A34A;color:#fff}
    .quiz-option.wrong .option-letter{background:#DC2626;color:#fff}
    .quiz-feedback{margin-top:.875rem;padding:.75rem 1rem;border-radius:var(--radius);font-size:.82rem;line-height:1.6;display:none}
    .quiz-feedback.show{display:block}
    .quiz-feedback.correct{background:#F0FDF4;border:1px solid #BBF7D0;color:#166534}
    .quiz-feedback.wrong{background:#FEF2F2;border:1px solid #FECACA;color:#991B1B}
    .quiz-score-bar{background:#fff;border:1.5px solid var(--brand-accent);border-radius:var(--radius-xl);padding:1.5rem;text-align:center;margin-top:1.5rem;display:none}
    .quiz-score-bar.show{display:block}
    .score-num{font-size:2.5rem;font-weight:900;color:var(--brand-primary)}
    .score-label{font-size:.875rem;color:var(--text-muted);margin-top:.25rem}
    .resource-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius-xl);padding:1.25rem 1.5rem;display:flex;align-items:center;gap:1rem;text-decoration:none;color:inherit;transition:all var(--transition);margin-bottom:.875rem}
    .resource-card:hover{border-color:#FF0000;box-shadow:0 4px 12px rgba(255,0,0,.08);transform:translateX(4px)}
    .resource-yt-icon{width:44px;height:44px;border-radius:var(--radius);background:#FF0000;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-size:1.2rem}
    .resource-title{font-size:.9rem;font-weight:700;color:var(--heading)}
    .resource-channel{font-size:.75rem;color:var(--text-muted);margin-top:2px}
    .resource-arrow{margin-left:auto;color:var(--text-muted);font-size:1.1rem;flex-shrink:0}
    .summary-card{background:linear-gradient(135deg,#F0FDF4,#DCFCE7);border:1.5px solid #86EFAC;border-radius:var(--radius-xl);padding:1.75rem}
    .summary-title{font-size:1rem;font-weight:800;color:var(--brand-primary);margin-bottom:1rem}
    .summary-list{list-style:none}
    .summary-list li{display:flex;align-items:flex-start;gap:10px;font-size:.875rem;color:var(--heading);padding:.5rem 0;border-bottom:1px solid rgba(34,197,94,.2);line-height:1.6}
    .summary-list li:last-child{border-bottom:none}
    .summary-list li::before{content:'✓';color:var(--brand-accent);font-weight:700;flex-shrink:0;margin-top:1px}
    .lesson-nav{display:flex;justify-content:space-between;align-items:center;padding-top:2rem;margin-top:2rem;border-top:1px solid var(--border);flex-wrap:wrap;gap:1rem}
    .progress-tracker{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);padding:1rem;margin-bottom:1.5rem}
    .progress-label{font-size:.72rem;font-weight:600;color:var(--text-muted);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.06em}
    .progress-bar-track{height:6px;background:var(--surface-2);border-radius:999px;overflow:hidden}
    .progress-bar-fill{height:100%;background:var(--brand-accent);border-radius:999px;transition:width .5s ease}
    .connective-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin:.875rem 0}
    .connective-card{background:#fff;border:1.5px solid var(--border);border-radius:var(--radius-lg);padding:1.1rem}
    .connective-symbol{font-size:1.5rem;font-family:'Georgia',serif;color:var(--brand-primary);font-weight:700;margin-bottom:.35rem}
    .connective-name{font-size:.82rem;font-weight:700;color:var(--heading);margin-bottom:.25rem}
    .connective-read{font-size:.75rem;color:var(--text-muted);margin-bottom:.5rem}
    .connective-rule{font-size:.78rem;color:var(--text);line-height:1.5;background:var(--surface-2);border-radius:var(--radius);padding:.4rem .6rem}
    @media(max-width:768px){.lesson-layout{grid-template-columns:1fr}.sidebar{display:none}.lesson-main{padding:1.5rem}}
  </style>

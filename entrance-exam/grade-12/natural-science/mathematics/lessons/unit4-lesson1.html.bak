          <div class="quiz-option" onclick="answer(4,'C','D')"><div class="option-letter">C</div>2sin x − 3cos x + C</div>
          <div class="quiz-option" onclick="answer(4,'D','D')"><div class="option-letter">D</div>2sin x − 3cos x + C</div>
        </div>

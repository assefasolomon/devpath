    <!-- SUMMARY -->
    <div class="section-block" id="summary">
      <div class="section-header">
        <div class="section-icon">📝</div>
        <div>
          <div class="section-title-text">Lesson Summary</div>
          <div class="section-subtitle">Everything you learned in Unit 4 Lesson 1</div>
        </div>
      </div>
      <div class="summary-card">
        <div class="summary-title">✅ Key Points — Antiderivatives and Indefinite Integrals</div>
        <ul class="summary-list">
          <li>An antiderivative F(x) of f(x) satisfies F'(x) = f(x). Integration reverses differentiation.</li>
          <li>The indefinite integral ∫f(x)dx = F(x) + C where C is the constant of integration.</li>
          <li>Always include +C for indefinite integrals — leaving it out is an error on the exam.</li>
          <li>Power Rule: ∫xⁿ dx = xⁿ⁺¹/(n+1) + C for n ≠ −1. Exception: ∫(1/x)dx = ln|x| + C.</li>
          <li>Key rules: ∫eˣ dx = eˣ+C, ∫sin x dx = −cos x+C, ∫cos x dx = sin x+C.</li>
          <li>U-substitution: let u = inner function, find du, rewrite integral in u, integrate, substitute back.</li>
          <li>Initial conditions: integrate to get F(x)+C, substitute the given point, solve for C.</li>
          <li>Verify any integral by differentiating your answer — you should get the original integrand back.</li>
        </ul>
      </div>
    </div>

    <div class="lesson-nav">
      <a href="../index.html" class="btn btn-ghost">← Course Index</a>
      <div style="text-align:center;font-size:.82rem;color:var(--text-muted)">Unit 4 · Lesson 1 of 3</div>
      <a href="unit4-lesson2.html" class="btn btn-primary">Next: Definite Integrals →</a>
    </div>
  </main>
</div>

<script>
  fetch('/api/auth/me', {credentials:'include'})
    .then(r => r.json())
    .then(d => { if (!d.user) location.href = '/login.html?reason=login_required'; })
    .catch(() => {});

  const answers   = {};
  const correct   = {1:'B', 2:'C', 3:'B', 4:'D', 5:'C'};
  const feedbacks = {
    1:{B:'✓ Correct! ∫5x⁴dx=x⁵, ∫3x²dx=x³, ∫−2dx=−2x. Always add +C.',wrong:'✗ Power rule: ∫5x⁴=x⁵, ∫3x²=x³, ∫−2=−2x. Answer: x⁵+x³−2x+C.'},
    2:{C:'✓ Correct! ∫(1/x)dx=ln|x|+C (not ln x — we need absolute value). ∫eˣdx=eˣ.',wrong:'✗ ∫(1/x)dx=ln|x|+C — absolute value is required. ∫eˣdx=eˣ. Answer: ln|x|+eˣ+C.'},
    3:{B:'✓ Correct! u=x²+1, du=2x dx, so 4x dx=2du. ∫2u³du=2·u⁴/4=(x²+1)⁴/2+C.',wrong:'✗ u=x²+1, du=2x dx. 4x dx=2du. ∫2u³du=u⁴/2=(x²+1)⁴/2+C.'},
    4:{D:'✓ Correct! ∫2cos x=2sin x, ∫3sin x=−3cos x. Result: 2sin x−3cos x+C.',wrong:'✗ ∫cos x=sin x, ∫sin x=−cos x. So 2cos x→2sin x, 3sin x→−3cos x. Answer: 2sin x−3cos x+C.'},
    5:{C:'✓ Correct! ∫(4x−3)dx=2x²−3x+C. f(2)=7: 2(4)−3(2)+C=8−6+C=2+C=7→C=5. f(x)=2x²−3x+5.',wrong:'✗ ∫(4x−3)dx=2x²−3x+C. Substitute f(2)=7: 8−6+C=7→C=5. f(x)=2x²−3x+5.'},
  };

  let answered = 0;

  function answer(qNum, chosen, correctAns) {
    if (answers[qNum]) return;
    answers[qNum] = chosen;
    answered++;
    const card    = document.getElementById('q' + qNum);
    const options = card.querySelectorAll('.quiz-option');
    const fb      = document.getElementById('q' + qNum + '-feedback');
    const letters = ['A','B','C','D'];
    options.forEach((opt,i) => {
      opt.classList.add('disabled');
      if (letters[i] === correctAns) opt.classList.add('correct');
      else if (letters[i] === chosen && chosen !== correctAns) opt.classList.add('wrong');
    });
    const isCorrect = chosen === correctAns;
    fb.textContent = isCorrect ? feedbacks[qNum][correctAns] : feedbacks[qNum].wrong;
    fb.className   = 'quiz-feedback show ' + (isCorrect ? 'correct' : 'wrong');
    updateProgress();
    if (answered === 5) showScore();
  }

  function showScore() {
    const score = Object.keys(answers).filter(q => answers[q] === correct[q]).length;
    document.getElementById('score-bar').classList.add('show');
    document.getElementById('score-num').textContent = score + '/5';
    const labels = ['📖 Review and retake.','📖 Keep studying.','📖 Almost there!','👍 Good work!','👍 Almost perfect!','🎉 Perfect! Unit 4 Lesson 1 mastered!'];
    document.getElementById('score-label').textContent = labels[score];
  }

  function retakeQuiz() {
    Object.keys(answers).forEach(k => delete answers[k]);
    answered = 0;
    for (let i = 1; i <= 5; i++) {
      document.getElementById('q'+i).querySelectorAll('.quiz-option').forEach(o => { o.className='quiz-option'; });
      document.getElementById('q'+i+'-feedback').className = 'quiz-feedback';
    }
    document.getElementById('score-bar').classList.remove('show');
    updateProgress();
    document.getElementById('quiz').scrollIntoView({behavior:'smooth'});
  }

  function updateProgress() {
    document.getElementById('progress-fill').style.width = (answered/5*100)+'%';
  }

  function scrollTo(id) {
    document.getElementById(id).scrollIntoView({behavior:'smooth',block:'start'});
    document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
    event.currentTarget.classList.add('active');
  }

  const sections = ['intro','explanation','formula','examples','quiz','resources','summary'];
  window.addEventListener('scroll', () => {
    let current = 'intro';
    sections.forEach(id => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 120) current = id;
    });
    document.querySelectorAll('.sidebar-link[onclick]').forEach(l => {
      const t = l.getAttribute('onclick').match(/'([^']+)'/)?.[1];
      l.classList.toggle('active', t === current);
    });
  });
</script>
</body>
</html>

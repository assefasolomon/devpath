      <!-- Q2 -->
      <div class="quiz-card" id="q2">
        <div class="quiz-num">Question 2 of 5</div>
        <div class="quiz-question">What are the x-coordinates of the intersection points of y = x and y = x²?</div>
        <div class="quiz-options">
          <div class="quiz-option" onclick="answer(2,'A','B')"><div class="option-letter">A</div> x = 0 only</div>
          <div class="quiz-option" onclick="answer(2,'B','B')"><div class="option-letter">B</div> x = 0 and x = 1</div>
          <div class="quiz-option" onclick="answer(2,'C','B')"><div class="option-letter">C</div> x = 1 and x = 2</div>
          <div class="quiz-option" onclick="answer(2,'D','B')"><div class="option-letter">D</div> x = −1 and x = 1</div>
        </div>
        <div class="quiz-feedback" id="q2-feedback"></div>
      </div>

      <!-- Q3 -->
      <div class="quiz-card" id="q3">
        <div class="quiz-num">Question 3 of 5</div>
        <div class="quiz-question">Find the area between y = x and y = x² from x = 0 to x = 1.</div>
        <div class="quiz-options">
          <div class="quiz-option" onclick="answer(3,'A','A')"><div class="option-letter">A</div> 1/6</div>
          <div class="quiz-option" onclick="answer(3,'B','A')"><div class="option-letter">B</div> 1/2</div>
          <div class="quiz-option" onclick="answer(3,'C','A')"><div class="option-letter">C</div> 1/3</div>
          <div class="quiz-option" onclick="answer(3,'D','A')"><div class="option-letter">D</div> 1/4</div>
        </div>
        <div class="quiz-feedback" id="q3-feedback"></div>
      </div>

      <!-- Q4 -->
      <div class="quiz-card" id="q4">
        <div class="quiz-num">Question 4 of 5</div>
        <div class="quiz-question">A particle has velocity v(t) = 2t − 4. What is its displacement from t = 0 to t = 4?</div>
        <div class="quiz-options">
          <div class="quiz-option" onclick="answer(4,'A','C')"><div class="option-letter">A</div> 4</div>
          <div class="quiz-option" onclick="answer(4,'B','C')"><div class="option-letter">B</div> 8</div>
          <div class="quiz-option" onclick="answer(4,'C','C')"><div class="option-letter">C</div> 0</div>
          <div class="quiz-option" onclick="answer(4,'D','C')"><div class="option-letter">D</div> −4</div>
        </div>
        <div class="quiz-feedback" id="q4-feedback"></div>
      </div>

      <!-- Q5 -->
      <div class="quiz-card" id="q5">
        <div class="quiz-num">Question 5 of 5</div>
        <div class="quiz-question">The area enclosed by y = 6 − x² and y = 2 equals ∫₋₂² [(6−x²) − 2] dx. What is this area?</div>
        <div class="quiz-options">
          <div class="quiz-option" onclick="answer(5,'A','D')"><div class="option-letter">A</div> 8</div>
          <div class="quiz-option" onclick="answer(5,'B','D')"><div class="option-letter">B</div> 16/3</div>
          <div class="quiz-option" onclick="answer(5,'C','D')"><div class="option-letter">C</div> 10</div>
          <div class="quiz-option" onclick="answer(5,'D','D')"><div class="option-letter">D</div> 32/3</div>

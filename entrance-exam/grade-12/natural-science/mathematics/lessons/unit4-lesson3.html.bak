    .progress-tracker{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);padding:1rem;margin-bottom:1.5rem}
    .progress-label{font-size:.72rem;font-weight:600;color:var(--text-muted);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.06em}
    .progress-bar-track{height:6px;background:var(--surface-2);border-radius:999px;overflow:hidden}
    .progress-bar-fill{height:100%;background:var(--brand-accent);border-radius:999px;transition:width .5s ease}
    .unit-complete-banner{background:linear-gradient(135deg,#14532D,#166534);border-radius:var(--radius-xl);padding:2rem;text-align:center;margin-top:2rem;color:#fff}
    .unit-complete-banner h3{font-size:1.4rem;font-weight:900;margin-bottom:.5rem}
    .unit-complete-banner p{color:rgba(255,255,255,.75);font-size:.9rem;margin-bottom:1.25rem}

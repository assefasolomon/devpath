    .sidebar-link{display:flex;align-items:center;gap:8px;padding:.4rem .5rem;border-radius:var(--radius);font-size:.82rem;color:var(--text-muted);text-decoration:none;cursor:pointer;transition:all var(--transition);border:none;background:none;width:100%;text-align:left;font-family:var(--font-sans)}
    .sidebar-link:hover{background:var(--surface-2);color:var(--brand-primary)}
    .sidebar-link.active{background:var(--brand-light);color:var(--brand-primary);font-weight:600}

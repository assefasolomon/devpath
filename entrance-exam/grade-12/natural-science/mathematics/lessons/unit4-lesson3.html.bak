        <a href="https://www.youtube.com/results?search_query=organic+chemistry+tutor+area+between+two+curves" target="_blank" class="resource-card">
          <div class="resource-yt-icon">▶</div>
          <div><div class="resource-title">Area Between Two Curves — Full Explanation</div><div class="resource-channel">The Organic Chemistry Tutor · YouTube</div></div>
          <div class="resource-arrow">→</div>
        </a>

        <a href="https://www.youtube.com/results?search_query=organic+chemistry+tutor+displacement+distance+velocity+integral" target="_blank" class="resource-card">
          <div class="resource-yt-icon">▶</div>
          <div><div class="resource-title">Displacement vs Distance Using Integration</div><div class="resource-channel">The Organic Chemistry Tutor · YouTube</div></div>
          <div class="resource-arrow">→</div>
        </a>

        <a href="https://www.youtube.com/results?search_query=organic+chemistry+tutor+applications+of+integration+practice" target="_blank" class="resource-card">
          <div class="resource-yt-icon">▶</div>
          <div><div class="resource-title">Applications of Integration — Practice Problems</div><div class="resource-channel">The Organic Chemistry Tutor · YouTube</div></div>
          <div class="resource-arrow">→</div>
        </a>
      </div>
    </div>

    <!-- ══════════════════════════════════════════
         SECTION 7: SUMMARY
    ══════════════════════════════════════════ -->
    <div class="section-block" id="summary">
      <div class="section-header">
        <div class="section-icon">📝</div>
        <div>
          <div class="section-title-text">Lesson Summary</div>
          <div class="section-subtitle">Everything you learned in Lesson 3</div>
        </div>
      </div>
      <div class="summary-card">
        <div class="summary-title">✅ Key Points — Applications of Integration</div>
        <ul class="summary-list">
          <li>The area between y = f(x) and the x-axis from a to b is ∫ₐᵇ f(x) dx — provided f(x) ≥ 0 on [a, b].</li>
          <li>If f(x) dips below the x-axis, the integral gives <strong>signed</strong> area. For <strong>total</strong> area, split at the zeros and take absolute values of each piece.</li>
          <li>Area between two curves f (top) and g (bottom): A = ∫ₐᵇ [f(x) − g(x)] dx.</li>
          <li>Find the limits a and b by setting f(x) = g(x) and solving for x (intersection points).</li>
          <li>Always check which curve is on top by testing a value inside the interval.</li>
          <li>Displacement from velocity: Δx = ∫ v(t) dt — this can be negative if the object moves backward.</li>
          <li>Total distance = ∫ |v(t)| dt — split where v(t) = 0 and sum the absolute values.</li>
          <li>The same FTC evaluation F(b) − F(a) is used for all these applications — the formula does not change, only the setup changes.</li>
        </ul>
      </div>
    </div>

    <!-- Unit Complete Banner -->
    <div class="unit-complete-banner">
      <div style="font-size:2.5rem;margin-bottom:.75rem">🎉</div>
      <h3>Unit 4 Complete!</h3>
      <p>You have finished all 3 lessons of Unit 4: Integral Calculus — Antiderivatives, Definite Integrals, and Applications. Unit 5 is coming soon.</p>
      <a href="../index.html" class="btn btn-accent btn-lg">Back to Course Index →</a>
    </div>

    <div class="lesson-nav" style="margin-top:2rem">
      <a href="unit4-lesson2.html" class="btn btn-ghost">← Lesson 2: Definite Integrals</a>
      <div style="text-align:center;font-size:.82rem;color:var(--text-muted)">Unit 4 · Lesson 3 of 3</div>
      <a href="../index.html" class="btn btn-primary">Course Index →</a>
    </div>

  </main>
</div>

<script>
  fetch('/api/auth/me', {credentials:'include'})
    .then(r => r.json())
    .then(d => { if (!d.user) location.href = '/login.html?reason=login_required'; })
    .catch(() => {});

  const answers  = {};
  const correct  = {1:'C', 2:'B', 3:'A', 4:'C', 5:'D'};
  const feedbacks = {
    1: { C:'✓ Correct! F(x)=x³/3. F(2)=8/3, F(0)=0. Area=8/3.', wrong:'✗ Antiderivative of x² is x³/3. [x³/3]₀² = 8/3 − 0 = 8/3.' },
    2: { B:'✓ Correct! Set x = x²: x² − x = 0, x(x−1) = 0, so x = 0 and x = 1.', wrong:'✗ Set x = x²: x² − x = x(x−1) = 0. Solutions: x = 0 and x = 1.' },
    3: { A:'✓ Correct! ∫₀¹ (x−x²) dx = [x²/2−x³/3]₀¹ = 1/2−1/3 = 1/6.', wrong:'✗ Top curve is y=x, bottom is y=x². ∫₀¹(x−x²)dx = 1/2−1/3 = 1/6.' },
    4: { C:'✓ Correct! ∫₀⁴ (2t−4) dt = [t²−4t]₀⁴ = (16−16)−0 = 0. Displacement is zero.', wrong:'✗ ∫₀⁴ (2t−4)dt = [t²−4t]₀⁴ = 16−16 = 0. The particle returned to start.' },
    5: { D:'✓ Correct! ∫₋₂² (4−x²) dx = [4x−x³/3]₋₂² = (8−8/3)−(−8+8/3) = 16/3+16/3 = 32/3.', wrong:'✗ ∫₋₂²(4−x²)dx = [4x−x³/3]₋₂² = 16/3−(−16/3) = 32/3.' },
  };

  let answered = 0;

  function answer(qNum, chosen, correctAns) {
    if (answers[qNum]) return;
    answers[qNum] = chosen;
    answered++;
    const card    = document.getElementById('q' + qNum);
    const options = card.querySelectorAll('.quiz-option');
    const fb      = document.getElementById('q' + qNum + '-feedback');
    const letters = ['A','B','C','D'];
    options.forEach((opt, i) => {
      opt.classList.add('disabled');
      if (letters[i] === correctAns) opt.classList.add('correct');
      else if (letters[i] === chosen && chosen !== correctAns) opt.classList.add('wrong');
    });
    const isCorrect = chosen === correctAns;
    fb.textContent = isCorrect ? feedbacks[qNum][correctAns] : feedbacks[qNum].wrong;
    fb.className   = 'quiz-feedback show ' + (isCorrect ? 'correct' : 'wrong');
    updateProgress();
    if (answered === 5) showScore();
  }

  function showScore() {
    const score = Object.keys(answers).filter(q => answers[q] === correct[q]).length;
    document.getElementById('score-bar').classList.add('show');
    document.getElementById('score-num').textContent = score + '/5';
    const labels = ['📖 Review the lesson and try again.','📖 Review the lesson and try again.','📖 Review the lesson and try again.','👍 Good! Review your mistakes.','👍 Almost perfect! One to review.','🎉 Perfect score! Unit 4 mastered!'];
    document.getElementById('score-label').textContent = labels[score];
  }

  function retakeQuiz() {
    Object.keys(answers).forEach(k => delete answers[k]);
    answered = 0;
    for (let i = 1; i <= 5; i++) {
      document.getElementById('q'+i).querySelectorAll('.quiz-option').forEach(o => { o.className = 'quiz-option'; });
      document.getElementById('q'+i+'-feedback').className = 'quiz-feedback';
    }
    document.getElementById('score-bar').classList.remove('show');
    updateProgress();
    document.getElementById('quiz').scrollIntoView({behavior:'smooth'});
  }

  function updateProgress() {
    document.getElementById('progress-fill').style.width = (answered / 5 * 100) + '%';
  }

  function scrollTo(id) {
    document.getElementById(id).scrollIntoView({behavior:'smooth', block:'start'});
    event.currentTarget.classList.add('active');
  }

  const sections = ['intro','explanation','formula','examples','quiz','resources','summary'];
  window.addEventListener('scroll', () => {
    let current = 'intro';
    sections.forEach(id => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 120) current = id;
    });
    document.querySelectorAll('.sidebar-link[onclick]').forEach(l => {
      const t = l.getAttribute('onclick').match(/'([^']+)'/)?.[1];
      l.classList.toggle('active', t === current);
    });
  });
</script>
</body>
</html>

    <div class="section-block" id="resources">
      <div class="section-header">
        <div class="section-icon">🎥</div>
        <div>
          <div class="section-title-text">Online Resources</div>
          <div class="section-subtitle">The Organic Chemistry Tutor — Applications of Integration</div>
        </div>
      </div>
      <div class="content-box">
        <p style="font-size:.875rem;color:var(--text-muted);margin-bottom:1.25rem">Watch these videos to reinforce the concepts in this lesson:</p>

        <a href="https://www.youtube.com/results?search_query=organic+chemistry+tutor+area+under+curve+integral" target="_blank" class="resource-card">
          <div class="resource-yt-icon">▶</div>
          <div><div class="resource-title">Area Under a Curve Using Definite Integrals</div><div class="resource-channel">The Organic Chemistry Tutor · YouTube</div></div>

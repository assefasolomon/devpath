        <div class="quiz-options">
          <div class="quiz-option" onclick="answer(1,'A','C')"><div class="option-letter">A</div> 4</div>
          <div class="quiz-option" onclick="answer(1,'B','C')"><div class="option-letter">B</div> 2</div>
